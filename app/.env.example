# Frontend environment. Copy to app/.env.
#
# DANGER: Vite inlines every VITE_* variable into the built bundle. Anything
# here is public. Never put a private key, a mnemonic or an API secret in this
# file. Keys live in the root .env, which the frontend never reads.

# Which network the demo runs against.
#   11155111 = Sepolia, where ENSv2 is live
#   1        = mainnet, after go-live
VITE_CHAIN_ID=11155111

# RPC the browser talks to.
#   Local fork demo:  http://127.0.0.1:8545
#   Live Sepolia:     your Sepolia RPC
VITE_RPC_URL=http://127.0.0.1:8545

# The name the demo watches, e.g. estmcmxci.eth
VITE_DEMO_NAME=

# Where the operator publishes its attempt log for the right pane.
# The pane renders contract events; this is only the transport.
VITE_OPERATOR_URL=http://127.0.0.1:8787

# Addresses come from config/networks.ts, keyed by VITE_CHAIN_ID.
# Do not add an address here.
